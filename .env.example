# Copy to .env and adjust. .env is git-ignored and must never be committed.
# No secret belongs in source, in a migration, or in a prompt.

# --- Database -----------------------------------------------------------
POSTGRES_PASSWORD=vibecode_local_only
DATABASE_URL=jdbc:postgresql://localhost:5432/vibecode
DATABASE_USERNAME=vibecode
DATABASE_PASSWORD=vibecode_local_only

# --- Web ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Model providers ----------------------------------------------------
# Not read by any code in this phase. Listed so keys have an obvious home
# outside the repository from the first day.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
