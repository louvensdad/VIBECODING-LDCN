# Copy to .env and adjust. .env is git-ignored and must never be committed.
# No secret belongs in source, in a migration, or in a prompt.

# --- Database -----------------------------------------------------------
POSTGRES_PASSWORD=vibecode_local_only
DATABASE_URL=jdbc:postgresql://localhost:5432/vibecode
DATABASE_USERNAME=vibecode
DATABASE_PASSWORD=vibecode_local_only

# --- Session ------------------------------------------------------------
# Marks the session cookie Secure, so the browser only ever sends it over TLS.
# Left false for local http development; it MUST be true anywhere the app is
# actually served, or the session id travels in the clear.
SESSION_COOKIE_SECURE=false

# --- Authentication abuse protection ------------------------------------
# Limits live in application.yml; override per environment if needed. Peers whose
# X-Forwarded-For may be believed -- EMPTY by default, and it must stay empty unless
# a proxy that OVERWRITES that header sits in front. The Next.js rewrite passes the
# client's own header through, so listing it would let any browser mint unlimited
# origin buckets and quietly disable the limiter.
# VIBECODE_SECURITY_AUTHRATELIMIT_TRUSTEDPROXIES=

# --- Web ----------------------------------------------------------------
# Where the Next.js server reaches the API. The browser never uses this: it
# talks only to the web app's own origin, which proxies /api through to here.
# That is what keeps the session and CSRF cookies same-origin, with no CORS
# configuration anywhere in the project.
API_INTERNAL_URL=http://localhost:9000

# --- Model providers ----------------------------------------------------
# Not read by any code in this phase. Listed so keys have an obvious home
# outside the repository from the first day.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
